# Server
PORT=3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Seals integration credentials (Stripe, Resend, …) at rest. Derived from the auth secret when unset.
# ENCRYPTION_KEY=another-long-random-string
BETTER_AUTH_URL=http://localhost:3000
STUDIO_ORIGIN=http://localhost:5173

# Sign in with Google (optional). Both set switches on "Continue with Google"; register
# <BETTER_AUTH_URL>/api/auth/callback/google as the OAuth client's redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Leave DATABASE_URL unset to run on embedded PGlite (data in apps/server/.data).
# Local Postgres 18:      postgres://localhost:5432/devias
# docker compose service: postgres://devias:devias@localhost:5433/devias
# DATABASE_URL=
# MIGRATE_ON_BOOT=1

# AI (optional). Without the key of the chosen provider the studio shows AI as not configured.
# AI_PROVIDER=anthropic     # anthropic | google | openai
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=          # also ANTHROPIC_BASE_URL, GEMINI_BASE_URL: a proxy or compatible server
# AI_MODEL=claude-opus-5    # default depends on the provider: gemini-2.5-pro, gpt-5
# AI_EFFORT=high            # low | medium | high | xhigh | max
# AI_MAX_TOKENS=16000
# AI_MAX_ITERATIONS=12
# AI_FALLBACKS=1            # server-side refusal fallbacks (beta)
# AI_REQUEST_TIMEOUT_MS=180000

# Studio
VITE_API_URL=http://localhost:3000
# VITE_MOCK=1
