{
  "name": "@devias/server-app",
  "version": "0.0.0",
  "private": true,
  "description": "Hono API server: Better Auth, workspace routing, records, metadata, modules, SSE change feed.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "auth:generate": "npx auth@1.7.5 generate --config src/auth/cli-config.ts --output src/db/schema/auth.ts --yes",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "actions:export": "tsx src/scripts/export-actions.ts",
    "navigation:reset": "tsx src/scripts/reset-navigation.ts",
    "seed:persons": "tsx --env-file-if-exists=../../.env src/scripts/seed-persons.ts",
    "seed:companies": "tsx --env-file-if-exists=../../.env src/scripts/seed-companies.ts",
    "seed:invoices": "tsx --env-file-if-exists=../../.env src/scripts/seed-invoices.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@devias/ai": "workspace:*",
    "@devias/core": "workspace:*",
    "@devias/data-engine": "workspace:*",
    "@devias/server": "workspace:*",
    "@devias/studio": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "sharp": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devias/mod-crm": "workspace:*",
    "@devias/mod-expenses": "workspace:*",
    "@devias/mod-inventory": "workspace:*",
    "@devias/mod-invoicing": "workspace:*",
    "@devias/mod-email-resend": "workspace:*",
    "@devias/mod-enrichment-context-dev": "workspace:*",
    "@devias/mod-payment-stripe": "workspace:*",
    "@devias/mod-products": "workspace:*",
    "@devias/mod-quotes": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
