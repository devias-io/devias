  },
  "dependencies": {
    "@devias/core": "workspace:*",
    "@devias/sdk": "workspace:*",
    "chokidar": "catalog:",
    "commander": "catalog:",
    "picocolors": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
