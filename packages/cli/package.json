{
  "name": "@devias/cli",
  "version": "0.0.0",
  "private": true,
  "description": "devias plan | apply | dev: reconcile a module manifest into a workspace using an API key.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devias": "./bin/devias.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
